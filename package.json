{
  "name": "remote-device-hub",
  "displayName": "Remote Device Hub",
  "description": "Use your authorized devices' file, shell and process tools in VS Code via MCP.",
  "version": "0.0.12",
  "publisher": "xdistribute",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.105.0" },
  "categories": ["AI", "Other"],
  "keywords": ["mcp", "agent", "remote", "device"],
  "main": "./out/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished", "onChatParticipant:xdistribute.remote-device-hub.chat"],
  "contributes": {
    "chatParticipants": [{
      "id": "xdistribute.remote-device-hub.chat",
      "name": "remote-device-hub",
      "fullName": "Remote Device Hub",
      "description": "Describe a remote device task, such as \"List my authorized devices\" or \"Check free disk space on a device\"",
      "isSticky": true
    }],
    "mcpServerDefinitionProviders": [
      { "id": "xdistribute.remote-device-hub", "label": "Remote Device Hub" }
    ],
    "commands": [
      { "command": "rdh.signIn", "title": "Sign In", "category": "Remote Device Hub" },
      { "command": "rdh.signOut", "title": "Sign Out", "category": "Remote Device Hub" },
      { "command": "rdh.showStatus", "title": "Show Status", "category": "Remote Device Hub" },
      { "command": "rdh.showLogs", "title": "Show Logs", "category": "Remote Device Hub" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
