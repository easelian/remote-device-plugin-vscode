{
  "name": "remote-device-hub",
  "displayName": "Remote Device Hub",
  "description": "Remote Device Hub (RDH): ask Copilot to inspect files, check logs, and run permitted commands on your paired Linux, macOS, and Windows devices.",
  "version": "0.1.1",
  "publisher": "easelian",
  "author": "Easelian",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "homepage": "https://rdh.easelian.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/easelian/remote-device-plugin-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/easelian/remote-device-plugin-vscode/issues"
  },
  "galleryBanner": {
    "color": "#1D1D1F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "rdh",
    "remote device hub",
    "easelian",
    "mcp",
    "agent",
    "remote",
    "device",
    "copilot",
    "files",
    "shell"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "chatSkills": [
      {
        "path": "./skills/remote-device-operations/SKILL.md"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "easelian.remote-device-hub",
        "label": "Remote Device Hub"
      }
    ],
    "commands": [
      {
        "command": "rdh.signIn",
        "title": "%command.signIn%",
        "category": "Remote Device Hub"
      },
      {
        "command": "rdh.signOut",
        "title": "%command.signOut%",
        "category": "Remote Device Hub"
      },
      {
        "command": "rdh.showStatus",
        "title": "%command.showStatus%",
        "category": "Remote Device Hub"
      },
      {
        "command": "rdh.showLogs",
        "title": "%command.showLogs%",
        "category": "Remote Device Hub"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "vsce package --no-dependencies",
    "skill:sync": "node scripts/sync-skill.cjs",
    "skill:check": "node scripts/sync-skill.cjs --check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "style:check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.118.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
